# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Node.js / Frontend dependencies & build
node_modules/
frontend/node_modules/
Auditlens_AI/frontend/node_modules/
Auditlens_AI/frontend/dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large archives (exceed GitHub 100MB limit)
*.zip
*.tar.gz
*.rar

# Databases & local storage
*.db
*.sqlite
*.sqlite3
*.db-journal
Auditlens_AI/auditlens_fraud.db

# Runtime uploads, generated reports and evidence files
**/uploads/*
!**/uploads/.gitkeep
**/reports/*.xlsx
!**/reports/.gitkeep
**/evidence_files/*
!**/evidence_files/.gitkeep

# ML model files & artifacts (if large)
artifacts/
Auditlens_AI/artifacts/
*.joblib
*.pkl

# Environment variables & local secrets
.env
.env.local
.env.*.local

# Operating System & Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
